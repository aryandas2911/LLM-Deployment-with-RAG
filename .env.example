# Copy this file to `.env` and replace the placeholder values.
# The real `.env` file contains secrets and must never be committed to Git.

# --- Pinecone (vector database) ---
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=llm-deployment-rag

# --- vLLM server (future permitted HTTPS endpoint) ---
# Kaggle does not permit tunneling, so this URL is a placeholder for a future
# host that explicitly allows remote API access. Use HTTPS, not HTTP.
# The local client accepts the base URL with or without `/v1`.
VLLM_API_BASE_URL=https://your-secure-endpoint.example/v1
# Keep this key different from PINECONE_API_KEY. Use a placeholder here only.
VLLM_API_KEY=your_vllm_api_key

# --- Model names (names only; nothing is downloaded by Task 1) ---
VLLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
