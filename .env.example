# Copy this file to `.env` and replace the placeholder values.
# The real `.env` file contains secrets and must never be committed to Git.

# --- Pinecone (vector database) ---
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=llm-deployment-rag

# --- vLLM server (runs on Kaggle, exposed in a later task) ---
# Use the OpenAI-compatible base URL. It usually ends with `/v1`.
VLLM_BASE_URL=https://your-kaggle-vllm-url.example.com/v1
VLLM_API_KEY=not-needed-yet

# --- Model names (names only; nothing is downloaded by Task 1) ---
VLLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
