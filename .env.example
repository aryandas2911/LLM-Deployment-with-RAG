# Copy this file to `.env` and replace the placeholder values.
# The real `.env` file contains secrets and must never be committed to Git.

# --- Local FastAPI backend ---
# Streamlit sends upload and chat requests to this URL. The default is used when
# this variable is missing.
FASTAPI_BASE_URL=http://127.0.0.1:8001

# --- Pinecone (vector database) ---
# Create a free account at https://app.pinecone.io, then create an API key in
# the Pinecone dashboard. Copy this file to `.env` and paste the real key there.
# `.env` is ignored by Git; never commit the real key.
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=llm-rag-index

# --- vLLM server (optional; only for generation mode) ---
# Retrieval mode works with Pinecone alone. Set both values below only when you
# have a permitted, reachable endpoint that allows remote API access.
# Kaggle does not permit tunneling, so its loopback URL cannot be used here.
# The local client accepts the base URL with or without `/v1`.
VLLM_API_BASE_URL=https://your-secure-endpoint.example/v1
# Keep this key different from PINECONE_API_KEY. Use a placeholder here only.
VLLM_API_KEY=your_vllm_api_key

# --- Model names (pinned in code, not read from .env) ---
# LLM: Qwen/Qwen2.5-1.5B-Instruct
# Embeddings: sentence-transformers/all-MiniLM-L6-v2
# Change these only by updating the backend, notebooks, and Pinecone index together.
